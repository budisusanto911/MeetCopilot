# Copy to .env.local (never commit .env.local)

# Primary Free AI (NVIDIA NIM: https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Auto-Fallback #1 (Optional free backups)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Auto-Fallback #2 (Local offline / sensitive NDA mode)
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Bridge server settings
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_PAIR_TOKEN=

# Optional comma-separated folders to index on startup
ALLOWED_CONTEXT_DIRS=
