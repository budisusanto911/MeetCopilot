{
  "manifest_version": 3,
  "name": "MeetCopilot — AI Meeting Translator & Reply Copilot",
  "version": "0.1.0",
  "description": "Real-time AI meeting translation (EN -> ID) and context-grounded reply suggestions with 7-layer token optimization.",
  "permissions": [
    "sidePanel",
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Buka MeetCopilot Side Panel"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Buka MeetCopilot Side Panel"
    },
    "copy-reply-1": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Salin Opsi Jawaban 1 (Quick)"
    },
    "copy-reply-2": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Salin Opsi Jawaban 2 (Context)"
    },
    "copy-reply-3": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Salin Opsi Jawaban 3 (Klarifikasi)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*"
      ],
      "js": ["content/caption-observer.js"],
      "run_at": "document_idle"
    }
  ]
}
